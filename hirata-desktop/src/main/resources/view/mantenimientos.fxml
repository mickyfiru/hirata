<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hirata.controller.MantenimientoController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <TableView fx:id="tableMantenimientos" prefHeight="350">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="250"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="150"/>
        </columns>
    </TableView>

    <Button text="Volver al dashboard" onAction="#volverDashboard"/>
</VBox>
