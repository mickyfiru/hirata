<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hirata.controller.CamionController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Gestión de Camiones"/>

    <HBox spacing="10">
        <TextField fx:id="txtPlaca" promptText="Placa"/>
        <TextField fx:id="txtModelo" promptText="Modelo"/>
        <TextField fx:id="txtAnio" promptText="Año"/>
        <Button text="Guardar" onAction="#guardarCamion"/>
    </HBox>

    <Label fx:id="lblMensaje"/>

    <TableView fx:id="tableCamiones" prefHeight="300">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
            <TableColumn fx:id="colPlaca" text="Placa" prefWidth="150"/>
            <TableColumn fx:id="colModelo" text="Modelo" prefWidth="200"/>
            <TableColumn fx:id="colAnio" text="Año" prefWidth="100"/>
        </columns>
    </TableView>

    <Button text="Volver al dashboard" onAction="#volverDashboard"/>
</VBox>
